    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "resources\r\n| where type =~ \"microsoft.insights/metricalerts\"\r\n| where resourceGroup == \"rg-azureops-hackathon\"\r\n| project\r\n    AlertName = name,\r\n    Enabled = tostring(properties.enabled),\r\n    Severity = tostring(properties.severity),\r\n    Description = tostring(properties.description)\r\n| order by AlertName asc",
        "size": 1,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "customWidth": "50",
      "name": "query - 7"
